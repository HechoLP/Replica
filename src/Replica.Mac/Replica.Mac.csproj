<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Replica</AssemblyName>
    <RootNamespace>Replica.Mac</RootNamespace>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Company>HechoLP</Company>
    <Description>Replica macOS environment snapshot application</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Replica.Core\Replica.Core.csproj" />
    <ProjectReference Include="..\Replica.Mac.Infrastructure\Replica.Mac.Infrastructure.csproj" />
    <ProjectReference Include="..\Replica.Storage\Replica.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
