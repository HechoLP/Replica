<Window
    x:Class="Replica.Mac.MainWindow"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Replica.Mac.ViewModels"
    Title="Replica"
    Width="1120"
    Height="760"
    MinWidth="900"
    MinHeight="640"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Grid ColumnDefinitions="240,*">
    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Spacing="4">
          <TextBlock Text="Replica" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="macOS Preview" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,40,0,0" Spacing="10">
          <Button Content="현재 Mac 스캔" HorizontalContentAlignment="Left" Command="{Binding ScanCommand}" AutomationProperties.Name="현재 Mac 스캔" />
          <Button Content="Snapshot 열기" HorizontalContentAlignment="Left" Command="{Binding OpenSnapshotCommand}" AutomationProperties.Name="Snapshot 열기" />
          <Button Content="업데이트 확인" HorizontalContentAlignment="Left" Command="{Binding CheckUpdateCommand}" AutomationProperties.Name="업데이트 확인" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="HechoLP/Replica" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="48,40" Spacing="24">
        <StackPanel Spacing="6">
          <TextBlock Text="Clone your setup, not your files." FontSize="32" FontWeight="Bold" />
          <TextBlock Text="macOS 환경을 안전하게 기록하고 Windows Snapshot도 검증해 열어볼 수 있습니다."
                     FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Classes="card" Background="#1A5B5CF0">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <TextBlock Text="PREVIEW" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="macOS에서는 스캔·Lightweight Snapshot 생성·검증을 제공합니다. 시스템 복원은 실행하지 않습니다."
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="현재 Mac" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="응용 프로그램, Homebrew, 환경변수, PATH, 글꼴을 읽기 전용으로 확인합니다."
                         TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Button Content="현재 Mac 스캔" Classes="primary" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="현재 Mac 환경 스캔 시작" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="Lightweight Snapshot" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="민감한 환경변수 값과 사용자 파일을 제외한 .replica 파일을 만듭니다."
                         TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Button Content="Snapshot 만들기" Command="{Binding CreateSnapshotCommand}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Lightweight Snapshot 만들기" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="스캔 요약" FontSize="20" FontWeight="SemiBold" />
              <Button Grid.Column="1" Content="취소" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            </Grid>
            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" />
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Text="응용 프로그램" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ApplicationCount}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Homebrew" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding HomebrewCount}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="환경 값 제외" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding SensitiveCount}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="경고" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding WarningCount}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="상태" FontSize="16" FontWeight="SemiBold" />
             <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
             <TextBlock Text="{Binding WarningSummary}" TextWrapping="Wrap" Foreground="#C94F45"
                        AutomationProperties.Name="스캔 경고 상세" />
             <TextBlock Text="{Binding SnapshotDetails}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button Content="Release 페이지 열기" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding HasReleasePage}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
