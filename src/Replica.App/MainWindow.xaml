<Window x:Class="Replica.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:Replica.Core.Navigation;assembly=Replica.Core"
        xmlns:views="clr-namespace:Replica.App.Views"
        Title="Replica"
        Width="1440"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        AutomationProperties.Name="Replica Windows 환경 마이그레이션 및 복구"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        KeyboardNavigation.TabNavigation="Continue"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Home}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Scan}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.SnapshotBuilder}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.DiffViewer}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.RestorePlan}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.RecoveryWizard}" />
        <KeyBinding Key="Comma" Modifiers="Control" Command="{Binding ShowSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource NavigationBackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,14">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="White" Text="Replica" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource NavigationTextBrush}"
                               Text="{DynamicResource ProductSubtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,16">
                    <Button AutomationProperties.Name="설정, Ctrl+쉼표"
                            Command="{Binding ShowSettingsCommand}"
                            Content="{DynamicResource NavSettings}"
                            Style="{DynamicResource ShellNavigationButtonStyle}" />
                    <Button AutomationProperties.Name="Replica 정보"
                            Command="{Binding ShowAboutCommand}"
                            Content="{DynamicResource NavAbout}"
                            Style="{DynamicResource ShellNavigationButtonStyle}" />
                    <TextBlock Margin="14,10,14,0"
                               Foreground="{DynamicResource NavigationTextBrush}"
                               FontSize="11"
                               Text="{Binding VersionText}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="22,8,0,5" Foreground="{DynamicResource NavigationTextBrush}" FontSize="11" Text="작업" />
                        <Button AutomationProperties.Name="홈, Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Home}" Content="{DynamicResource NavHome}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="현재 PC 스캔, Ctrl+2" Command="{Binding ScanCurrentComputerCommand}" Content="{DynamicResource NavScan}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="Snapshot Builder, Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.SnapshotBuilder}" Content="{DynamicResource NavSnapshotBuilder}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="Comparison" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Comparison}" Content="{DynamicResource NavComparison}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="Diff Viewer, Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.DiffViewer}" Content="{DynamicResource NavDiffViewer}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="Restore Plan, Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.RestorePlan}" Content="{DynamicResource NavRestorePlan}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="초기화 후 복구, Ctrl+6" Command="{Binding RestoreAfterResetCommand}" Content="{DynamicResource NavRecovery}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="복원 실행" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Execution}" Content="{DynamicResource NavExecution}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="복원 결과" Command="{Binding NavigateCommand}" CommandParameter="{x:Static nav:NavigationDestination.Result}" Content="{DynamicResource NavResult}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <TextBlock Margin="22,18,0,5" Foreground="{DynamicResource NavigationTextBrush}" FontSize="11" Text="관리" />
                        <Button AutomationProperties.Name="Snapshot 및 복원 기록" Command="{Binding ShowSnapshotHistoryCommand}" Content="{DynamicResource NavHistory}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                        <Button AutomationProperties.Name="업데이트 확인" Command="{Binding CheckForUpdatesCommand}" Content="{DynamicResource NavUpdate}" Style="{DynamicResource ShellNavigationButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Padding="32,20"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level1"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentPageTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding CurrentPageDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,7" VerticalAlignment="Center" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="14">
                        <TextBlock Foreground="{DynamicResource AccentBrush}" Text="{DynamicResource SafetyBadge}" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding}" KeyboardNavigation.TabNavigation="Continue">
                <ContentControl.Resources>
                    <DataTemplate x:Key="HomePageTemplate"><views:HomeView /></DataTemplate>
                    <DataTemplate x:Key="ScanPageTemplate"><views:ScanView /></DataTemplate>
                    <DataTemplate x:Key="SnapshotBuilderPageTemplate"><views:SnapshotBuilderView DataContext="{Binding SnapshotBuilder}" /></DataTemplate>
                    <DataTemplate x:Key="ComparisonPageTemplate"><views:ComparisonView /></DataTemplate>
                    <DataTemplate x:Key="DiffViewerPageTemplate"><views:DiffWorkspaceView DataContext="{Binding DiffViewer}" /></DataTemplate>
                    <DataTemplate x:Key="RestorePlanPageTemplate"><views:RestorePlanView DataContext="{Binding RestoreDryRun}" /></DataTemplate>
                    <DataTemplate x:Key="RecoveryPageTemplate"><views:RecoveryWorkspaceView DataContext="{Binding RecoveryWizard}" /></DataTemplate>
                    <DataTemplate x:Key="ExecutionPageTemplate"><views:ExecutionView DataContext="{Binding Execution}" /></DataTemplate>
                    <DataTemplate x:Key="ResultPageTemplate"><views:ResultView DataContext="{Binding Result}" /></DataTemplate>
                    <DataTemplate x:Key="HistoryPageTemplate"><views:HistoryView DataContext="{Binding SnapshotHistory}" /></DataTemplate>
                    <DataTemplate x:Key="SettingsPageTemplate"><views:SettingsView DataContext="{Binding Settings}" /></DataTemplate>
                    <DataTemplate x:Key="AboutPageTemplate"><views:AboutView /></DataTemplate>
                    <DataTemplate x:Key="UpdatePageTemplate"><views:UpdateView DataContext="{Binding Update}" /></DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource HomePageTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="1"><Setter Property="ContentTemplate" Value="{StaticResource ScanPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="2"><Setter Property="ContentTemplate" Value="{StaticResource SnapshotBuilderPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="3"><Setter Property="ContentTemplate" Value="{StaticResource ComparisonPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="4"><Setter Property="ContentTemplate" Value="{StaticResource DiffViewerPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="5"><Setter Property="ContentTemplate" Value="{StaticResource RestorePlanPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="6"><Setter Property="ContentTemplate" Value="{StaticResource RecoveryPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="7"><Setter Property="ContentTemplate" Value="{StaticResource ExecutionPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="8"><Setter Property="ContentTemplate" Value="{StaticResource ResultPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="9"><Setter Property="ContentTemplate" Value="{StaticResource HistoryPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="10"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="11"><Setter Property="ContentTemplate" Value="{StaticResource AboutPageTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPageIndex}" Value="12"><Setter Property="ContentTemplate" Value="{StaticResource UpdatePageTemplate}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Border Grid.Row="2" Padding="24,9" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock AutomationProperties.LiveSetting="Polite"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding Compatibility.Message}" />
            </Border>
        </Grid>
    </Grid>
</Window>
