<Window x:Class="Replica.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Replica.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Replica"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="40,30,40,24"
                Background="{DynamicResource HeaderBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="34"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Tagline}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BadgeBackgroundBrush}"
                        CornerRadius="14">
                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding VersionText}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="40,28"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920">
                <TextBlock Margin="0,0,0,14"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="시작하기" />

                <WrapPanel>
                    <Button Command="{Binding ScanCurrentComputerCommand}"
                            Content="현재 PC 스캔"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding CreateSnapshotCommand}"
                            Content="Snapshot 만들기"
                            Style="{DynamicResource PrimaryActionButtonStyle}" />
                    <Button Command="{Binding CreateRecoverySnapshotCommand}"
                            Content="초기화 복구 Snapshot 만들기"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding OpenSnapshotCommand}"
                            Content="Snapshot 열기"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding RestoreAfterResetCommand}"
                            Content="초기화 후 복구"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding ShowSnapshotHistoryCommand}"
                            Content="Snapshot 기록"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Content="업데이트 확인"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding ShowSettingsCommand}"
                            Content="설정"
                            Style="{DynamicResource ActionButtonStyle}" />
                    <Button Command="{Binding ShowAboutCommand}"
                            Content="정보"
                            Style="{DynamicResource ActionButtonStyle}" />
                </WrapPanel>

                <views:PortableSnapshotView DataContext="{Binding PortableSnapshot}" />

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SnapshotHistory.IsVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel DataContext="{Binding SnapshotHistory}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="Snapshot 기록" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Snapshot 본문이 아닌 메타데이터와 비교 인덱스만 SQLite에 저장합니다." />
                            </StackPanel>
                            <WrapPanel Grid.Column="1">
                                <Button Margin="0,0,8,0"
                                        Padding="14,8"
                                        Command="{Binding RefreshCommand}"
                                        Content="새로 고침" />
                                <Button Padding="14,8"
                                        Command="{Binding AddSnapshotCommand}"
                                        Content="Snapshot 기록 추가" />
                            </WrapPanel>
                        </Grid>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />

                        <DataGrid Margin="0,12,0,0"
                                  MaxHeight="260"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedSnapshot}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150" Header="이름" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="180" Header="설명" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="130" Header="태그" Binding="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="120" Header="생성 시각" Binding="{Binding CreatedAt}" IsReadOnly="True" />
                                <DataGridTextColumn Width="105" Header="종류" Binding="{Binding SnapshotType}" IsReadOnly="True" />
                                <DataGridTextColumn Width="110" Header="크기" Binding="{Binding FileSize}" IsReadOnly="True" />
                                <DataGridTextColumn Width="120" Header="원본 PC" Binding="{Binding SourceMachineName}" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Width="75" Header="암호화" Binding="{Binding IsEncrypted}" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Width="85" Header="파일 존재" Binding="{Binding FileExists}" IsReadOnly="True" />
                                <DataGridTextColumn Width="85" Header="환경 점수" Binding="{Binding EnvironmentScore}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" Header="파일 경로" Binding="{Binding FilePath}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Padding="14,8"
                                    Command="{Binding SaveDetailsCommand}"
                                    Content="이름·설명·태그 저장" />
                            <Button Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding DeleteSnapshotCommand}"
                                    Content="삭제" />
                        </WrapPanel>

                        <TextBlock Margin="0,18,0,7"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Snapshot 간 비교" />
                        <WrapPanel>
                            <TextBlock Margin="0,7,8,0" Text="이전" />
                            <ComboBox Width="240"
                                      DisplayMemberPath="DisplayLabel"
                                      ItemsSource="{Binding Snapshots}"
                                      SelectedItem="{Binding FromSnapshot}" />
                            <TextBlock Margin="12,7,8,0" Text="→ 이후" />
                            <ComboBox Width="240"
                                      DisplayMemberPath="DisplayLabel"
                                      ItemsSource="{Binding Snapshots}"
                                      SelectedItem="{Binding ToSnapshot}" />
                            <Button Margin="10,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding CompareCommand}"
                                    Content="비교" />
                            <Button Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding CreatePastRestorePlanCommand}"
                                    Content="이전 상태 Restore Plan" />
                        </WrapPanel>
                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding ComparisonSummary}" />
                        <DataGrid Margin="0,8,0,0"
                                  MaxHeight="300"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding ComparisonItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Header="변화" Binding="{Binding Change}" />
                                <DataGridTextColumn Width="100" Header="영역" Binding="{Binding Area}" />
                                <DataGridTextColumn Width="180" Header="항목" Binding="{Binding Name}" />
                                <DataGridTextColumn Width="150" Header="이전" Binding="{Binding Before}" />
                                <DataGridTextColumn Width="150" Header="이후" Binding="{Binding After}" />
                                <DataGridTextColumn Width="100" Header="용량 변화" Binding="{Binding SizeDelta}" />
                                <DataGridTextColumn Width="80" Header="Hash" Binding="{Binding Hash}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecoveryWizard.IsVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel DataContext="{Binding RecoveryWizard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="초기화 후 복구" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding CurrentStepText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    Command="{Binding CancelCommand}"
                                    Content="복구 취소" />
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SourceComputerText}"
                                   TextWrapping="Wrap" />

                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,7,7"
                                            Padding="8,5"
                                            Background="{DynamicResource BadgeBackgroundBrush}"
                                            CornerRadius="8">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Number}" />
                                            <Run Text=". " />
                                            <Run Text="{Binding Name}" />
                                            <Run Text=" · " />
                                            <Run Foreground="{DynamicResource AccentBrush}" Text="{Binding State}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,10,0,5"
                                   FontWeight="SemiBold"
                                   Text="드라이브 경로 매핑" />
                        <DataGrid MaxHeight="190"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding PathMappings}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="210" Header="원본 경로" Binding="{Binding SourcePath}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" Header="새 경로" Binding="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="105" Header="적용 대상" Binding="{Binding Scope}" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="145" Header="충돌 처리">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding ConflictBehaviorOptions}"
                                                      SelectedItem="{Binding ConflictBehavior, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="100" Header="예상 용량" Binding="{Binding EstimatedBytes}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Padding="14,8" Command="{Binding AnalyzeCommand}" Content="현재 PC 분석" IsEnabled="{Binding CanAnalyze}" />
                            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding ApprovePlanCommand}" Content="계획 최종 승인" IsEnabled="{Binding CanApprovePlan}" />
                            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding ExecuteCommand}" Content="복원 실행" IsEnabled="{Binding CanExecute}" />
                            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding RetryFailedCommand}" Content="실패 작업 재시도" IsEnabled="{Binding CanRetry}" />
                            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding ApproveRestartCommand}" Content="재부팅 후 재개 등록" IsEnabled="{Binding CanApproveRestart}" />
                            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding ConfirmResumeCommand}" Content="복구 계속" IsEnabled="{Binding CanConfirmResume}" />
                        </WrapPanel>

                        <TextBlock Margin="0,12,0,0" Text="{Binding PlanSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding ScoreText}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding ResultText}" TextWrapping="Wrap" />

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding HardwareDifferences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="하드웨어 경고 · " />
                                        <Run Text="{Binding Category}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Guidance}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ManualActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="수동 작업 · " />
                                        <Run Text="{Binding DisplayName}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Guidance}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="현재 PC 스캔" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ScanStatus}" />
                        <ProgressBar Height="8"
                                     Margin="0,14,0,0"
                                     Maximum="100"
                                     Value="{Binding ScanProgressPercentage}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ScanCurrentComputerCancelCommand}"
                                Content="스캔 취소">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{DynamicResource ActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Margin="0,14,0,0"
                                   FontFamily="Consolas"
                                   Text="{Binding ScanSummaryText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanSummaryVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel DataContext="{Binding Rollback}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="롤백" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Replica가 변경한 항목만 Journal 검증 후 되돌립니다." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Padding="14,8"
                                    Command="{Binding RefreshSessionsCommand}"
                                    Content="최근 복원 세션" />
                        </Grid>
                        <ListBox Margin="0,14,0,0"
                                 MaxHeight="120"
                                 ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding SessionId}" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding UpdatedAt}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding State}" />
                                            <Run Text=" · 자동 " />
                                            <Run Text="{Binding AutomaticCount}" />
                                            <Run Text=" · 수동 " />
                                            <Run Text="{Binding ManualCount}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Padding="14,8"
                                    Command="{Binding PreviewRollbackCommand}"
                                    Content="롤백 미리보기" />
                            <Button Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ApproveRollbackCommand}"
                                    Content="롤백 계획 승인" />
                            <Button Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteRollbackCommand}"
                                    Content="롤백 실행" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />
                        <DataGrid Margin="0,12,0,0"
                                  MaxHeight="260"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="160" Header="변경 항목" Binding="{Binding Name}" />
                                <DataGridTextColumn Width="95" Header="유형" Binding="{Binding Kind}" />
                                <DataGridTextColumn Width="90" Header="상태" Binding="{Binding State}" />
                                <DataGridTextColumn Width="90" Header="자동 롤백" Binding="{Binding Automatic}" />
                                <DataGridTextColumn Width="80" Header="관리자" Binding="{Binding Administrator}" />
                                <DataGridTextColumn Width="80" Header="선택" Binding="{Binding Selection}" />
                                <DataGridTextColumn Width="*" Header="수동 조치" Binding="{Binding ManualInstruction}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{Binding State}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Message}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel DataContext="{Binding RestoreDryRun}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="Restore Plan Dry Run" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding StatusText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Padding="14,8"
                                        Command="{Binding RejectPlanCommand}"
                                        Content="계획 취소"
                                        IsEnabled="{Binding CanReview}" />
                                <Button Padding="14,8"
                                        Command="{Binding ConfirmPlanCommand}"
                                        Content="계획 확인 완료"
                                        IsEnabled="{Binding CanReview}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,10"
                                            Padding="12,8"
                                            Background="{DynamicResource WindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Text="{Binding Name}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Value}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid MaxHeight="360"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Actions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="120" Header="작업" Binding="{Binding Type}" />
                                <DataGridTextColumn Width="150" Header="이름" Binding="{Binding Name}" />
                                <DataGridTextColumn Width="180" Header="설명" Binding="{Binding Description}" />
                                <DataGridTextColumn Width="110" Header="원본" Binding="{Binding OriginalValue}" />
                                <DataGridTextColumn Width="110" Header="현재" Binding="{Binding CurrentValue}" />
                                <DataGridTextColumn Width="110" Header="목표" Binding="{Binding TargetValue}" />
                                <DataGridTextColumn Width="70" Header="위험도" Binding="{Binding Risk}" />
                                <DataGridTextColumn Width="70" Header="관리자" Binding="{Binding Administrator}" />
                                <DataGridTextColumn Width="70" Header="재부팅" Binding="{Binding Restart}" />
                                <DataGridTextColumn Width="70" Header="롤백" Binding="{Binding Rollback}" />
                                <DataGridTextColumn Width="70" Header="의존" Binding="{Binding DependencyCount}" />
                                <DataGridTextColumn Width="80" Header="예상 시간" Binding="{Binding EstimatedDuration}" />
                                <DataGridTextColumn Width="95" Header="다운로드" Binding="{Binding EstimatedDownload}" />
                                <DataGridTextColumn Width="70" Header="선택" Binding="{Binding Selection}" />
                                <DataGridTextColumn Width="90" Header="처리" Binding="{Binding Handling}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel DataContext="{Binding DiffViewer}">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding OverallScoreText}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding CoverageText}" />
                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding CategoryScores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,10"
                                            Padding="12,8"
                                            Background="{DynamicResource WindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Text="{Binding Name}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Score}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusText}" />
                        <DataGrid MaxHeight="320"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="95" Header="유형" Binding="{Binding Type}" />
                                <DataGridTextColumn Width="95" Header="영역" Binding="{Binding Area}" />
                                <DataGridTextColumn Width="160" Header="항목" Binding="{Binding Name}" />
                                <DataGridTextColumn Width="120" Header="Snapshot" Binding="{Binding Source}" />
                                <DataGridTextColumn Width="120" Header="현재 PC" Binding="{Binding Target}" />
                                <DataGridTextColumn Width="110" Header="자동 복원" Binding="{Binding AutomaticRestore}" />
                                <DataGridTextColumn Width="70" Header="위험도" Binding="{Binding Risk}" />
                                <DataGridTextColumn Width="70" Header="관리자" Binding="{Binding Administrator}" />
                                <DataGridTextColumn Width="70" Header="재부팅" Binding="{Binding Restart}" />
                                <DataGridTextColumn Width="70" Header="일치율" Binding="{Binding Similarity}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSnapshotTypePickerVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Snapshot 유형 선택" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SnapshotTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,10"
                                            Padding="16,12"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{DynamicResource WindowBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.SelectSnapshotTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding Description}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="40,12"
                Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding Compatibility.Message}" />
        </Border>
    </Grid>
</Window>
