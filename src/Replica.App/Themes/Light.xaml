<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF182033" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF667085" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4338CA" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FFEEF2FF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E7EC" />

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="276" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle"
           BasedOn="{StaticResource ActionButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
</ResourceDictionary>
