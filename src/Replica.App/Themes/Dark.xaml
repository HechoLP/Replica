<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF101828" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF1D2939" />
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FF1D2939" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1D2939" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF98A2B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF818CF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA5B4FC" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FF312E81" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF344054" />

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="276" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle"
           BasedOn="{StaticResource ActionButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FF101828" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
</ResourceDictionary>
