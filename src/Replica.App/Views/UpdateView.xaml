<UserControl x:Class="Replica.App.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,18,0,0"
            Padding="22"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="GitHub Releases 업데이트" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="공식 HechoLP/Replica Release만 조회하고 다운로드합니다." />
                </StackPanel>
                <WrapPanel Grid.Column="1">
                    <ComboBox Width="120"
                              ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel}" />
                    <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding CheckCommand}" Content="다시 확인" />
                </WrapPanel>
            </Grid>

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding StatusText}" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="현재" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CurrentVersion}" />
                <TextBlock Grid.Column="2" Text="최신" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding LatestVersion}" />
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Release" />
                <TextBlock Grid.Column="1" Text="{Binding ReleaseName}" />
            </Grid>
            <TextBlock Margin="0,6,0,0" Text="{Binding PublishedAt, StringFormat=Published: {0}}" />
            <TextBlock Margin="0,6,0,0" Text="{Binding AssetInformation}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ChecksumInformation}" TextWrapping="Wrap" />
            <ProgressBar Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" />

            <WrapPanel Margin="0,12,0,0">
                <Button Padding="14,8" Command="{Binding ShowReleaseNotesCommand}" Content="변경 내용 보기" />
                <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding DownloadCommand}" Content="다운로드" />
                <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding LaterCommand}" Content="나중에" />
                <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding SkipVersionCommand}" Content="이 버전 건너뛰기" />
                <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding InstallCommand}" Content="Installer 실행" />
            </WrapPanel>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AreReleaseNotesVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
