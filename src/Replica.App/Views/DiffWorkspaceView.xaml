<UserControl x:Class="Replica.App.Views.DiffWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Diff Viewer">
    <Grid Margin="32,26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{DynamicResource PageCardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="Tree" />
                <TreeView ItemsSource="{Binding TreeGroups}" AutomationProperties.Name="차이 영역 Tree">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                            <TextBlock><Run Text="{Binding Name}" /><Run Text="  " /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Type}" /></TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{DynamicResource PageCardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <TextBox Margin="0,0,10,0" AutomationProperties.Name="Diff 검색" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="항목, 범주, 값 검색" />
                        <ComboBox Grid.Column="1" AutomationProperties.Name="Diff 유형 필터" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
                    </Grid>
                    <TextBlock Margin="0,9,0,12" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Right" Style="{DynamicResource PrimaryActionButtonStyle}" Command="{Binding DataContext.BuildRestorePlanCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="선택 항목으로 Restore Plan 만들기" />
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Items}" AutomationProperties.Name="필터된 차이 목록">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="55" Header="선택" Binding="{Binding IsSelected}" />
                        <DataGridTextColumn Width="100" Header="유형" Binding="{Binding Type}" IsReadOnly="True" />
                        <DataGridTextColumn Width="100" Header="영역" Binding="{Binding Area}" IsReadOnly="True" />
                        <DataGridTextColumn Width="170" Header="항목" Binding="{Binding Name}" IsReadOnly="True" />
                        <DataGridTextColumn Width="140" Header="원본 값" Binding="{Binding Source}" IsReadOnly="True" />
                        <DataGridTextColumn Width="140" Header="현재 값" Binding="{Binding Target}" IsReadOnly="True" />
                        <DataGridTextColumn Width="80" Header="위험도" Binding="{Binding Risk}" IsReadOnly="True" />
                        <DataGridTextColumn Width="100" Header="관리자" Binding="{Binding Administrator}" IsReadOnly="True" />
                        <DataGridTextColumn Width="100" Header="재부팅" Binding="{Binding Restart}" IsReadOnly="True" />
                        <DataGridTextColumn Width="190" Header="권장 해결" Binding="{Binding Recommendation}" IsReadOnly="True" />
                        <DataGridTextColumn Width="*" Header="Reason" Binding="{Binding Reason}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
