<UserControl x:Class="Replica.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Replica 정보">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="850">
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="32" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Margin="0,7,0,0" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Tagline}" />
                    <TextBlock Margin="0,14,0,0" FontSize="20" Foreground="{DynamicResource AccentBrush}" Text="{Binding VersionText}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource PageCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Margin="0,7" FontWeight="SemiBold" Text="GitHub 저장소" /><TextBlock Grid.Column="1" Margin="0,7" Text="{Binding RepositoryUrl}" />
                    <TextBlock Grid.Row="1" Margin="0,7" FontWeight="SemiBold" Text="GitHub Releases" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7" Text="{Binding ReleasesUrl}" />
                    <TextBlock Grid.Row="2" Margin="0,7" FontWeight="SemiBold" Text="라이선스" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7" Text="{Binding LicenseText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Margin="0,7" FontWeight="SemiBold" Text="로그 폴더" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7" Text="{Binding LogsDirectory}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Button Width="220" Height="48" HorizontalAlignment="Left" AutomationProperties.Name="GitHub Releases 업데이트 확인" Command="{Binding CheckForUpdatesCommand}" Content="업데이트 확인" Style="{DynamicResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
