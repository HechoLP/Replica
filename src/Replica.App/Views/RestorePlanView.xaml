<UserControl x:Class="Replica.App.Views.RestorePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diff="clr-namespace:Replica.Core.Diffing;assembly=Replica.Core"
             xmlns:nav="clr-namespace:Replica.Core.Navigation;assembly=Replica.Core"
             AutomationProperties.Name="Restore Plan과 Dry Run">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120">
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="복원 모드" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding SelectModeCommand}" CommandParameter="{x:Static diff:DiffRestoreMode.Safe}" Content="Safe" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding SelectModeCommand}" CommandParameter="{x:Static diff:DiffRestoreMode.Recommended}" Content="Recommended" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding SelectModeCommand}" CommandParameter="{x:Static diff:DiffRestoreMode.Exact}" Content="Exact" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Summary}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Width="180" Margin="0,0,10,10" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Value}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="작업 목록 · Dry Run" />
                    <TextBlock Margin="0,5,0,10" Foreground="{DynamicResource SecondaryTextBrush}" Text="다운로드·파일 복원 용량, 관리자 권한, 재부팅, 롤백, Manual Action을 실행 전에 확인합니다." TextWrapping="Wrap" />
                    <DataGrid MaxHeight="410" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Actions}" AutomationProperties.Name="Restore Plan 작업 목록">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120" Header="작업" Binding="{Binding Type}" />
                            <DataGridTextColumn Width="160" Header="이름" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="200" Header="설명" Binding="{Binding Description}" />
                            <DataGridTextColumn Width="110" Header="원본" Binding="{Binding OriginalValue}" />
                            <DataGridTextColumn Width="110" Header="현재" Binding="{Binding CurrentValue}" />
                            <DataGridTextColumn Width="110" Header="목표" Binding="{Binding TargetValue}" />
                            <DataGridTextColumn Width="75" Header="위험" Binding="{Binding Risk}" />
                            <DataGridTextColumn Width="80" Header="관리자" Binding="{Binding Administrator}" />
                            <DataGridTextColumn Width="80" Header="재부팅" Binding="{Binding Restart}" />
                            <DataGridTextColumn Width="75" Header="롤백" Binding="{Binding Rollback}" />
                            <DataGridTextColumn Width="100" Header="다운로드" Binding="{Binding EstimatedDownload}" />
                            <DataGridTextColumn Width="90" Header="처리" Binding="{Binding Handling}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,14,0,8" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Text="계획 승인만으로 실행되지 않습니다. Execution 화면에서 다시 최종 승인해야 합니다." />
                    <WrapPanel>
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding RejectPlanCommand}" Content="계획 취소" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding ConfirmPlanCommand}" Content="Dry Run 검토 승인" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static nav:NavigationDestination.Execution}" Content="Execution으로 이동" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
