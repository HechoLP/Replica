<UserControl x:Class="Replica.App.Views.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:Replica.Core.Navigation;assembly=Replica.Core"
             AutomationProperties.Name="Restore Execution">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120">
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="20" FontWeight="SemiBold" Text="전체 진행률" />
                            <TextBlock Margin="0,7,0,0" AutomationProperties.LiveSetting="Assertive" Text="{Binding CurrentStage, StringFormat=현재 단계: {0}}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CurrentAction, StringFormat=현재 작업: {0}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="{Binding ProgressPercentage, StringFormat={}{0}%}" />
                    </Grid>
                    <ProgressBar Margin="0,16,0,0" Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" />
                    <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="최종 승인" />
                    <TextBlock Margin="0,6,0,10" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Text="승인된 Restore Plan의 선택 작업만 실행합니다. Journal 기록 실패 시 변경하지 않으며 자동 재부팅하지 않습니다." TextWrapping="Wrap" />
                    <CheckBox AutomationProperties.Name="복원 실행 최종 승인" IsChecked="{Binding IsFinalApprovalChecked}" Content="Dry Run과 위험도·관리자 권한·재부팅·Rollback 가능 여부를 검토했습니다." />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding StartCommand}" Content="복원 실행" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding StartCancelCommand}" Content="취소 요청" IsEnabled="{Binding CanCancel}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding RetryFailedCommand}" Content="실패 재시도 준비" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static nav:NavigationDestination.Result}" Content="Result 열기" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="로그 요약" />
                    <TextBlock Margin="0,5,0,10" Foreground="{DynamicResource SecondaryTextBrush}" Text="민감 값과 파일 내용은 표시하거나 기록하지 않습니다." />
                    <DataGrid MaxHeight="360" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding LogSummary}" AutomationProperties.Name="복원 실행 로그 요약">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="90" Header="시각" Binding="{Binding Time}" />
                            <DataGridTextColumn Width="220" Header="작업" Binding="{Binding Action}" />
                            <DataGridTextColumn Width="110" Header="상태" Binding="{Binding State}" />
                            <DataGridTextColumn Width="*" Header="요약" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
