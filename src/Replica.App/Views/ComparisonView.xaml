<UserControl x:Class="Replica.App.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:Replica.Core.Navigation;assembly=Replica.Core"
             AutomationProperties.Name="환경 비교">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" DataContext="{Binding DiffViewer}">
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding OverallScoreText}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CoverageText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,4,0,12" AutomationProperties.HeadingLevel="Level2" FontSize="20" FontWeight="SemiBold" Text="카테고리 점수" />
            <ItemsControl ItemsSource="{Binding CategoryScores}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="205" Margin="0,0,12,12" Style="{DynamicResource PageCardStyle}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Margin="0,7,0,0" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="{Binding Score}" />
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ComparableCount, StringFormat=비교 {0}개}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="차이 요약" />
                    <TextBlock Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}" Text="Missing · VersionMismatch · Config Difference · File Difference · Extra · Unsupported · Manual Action을 구분합니다." TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,8" Padding="10,6" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="8"><TextBlock><Run Text="{Binding Type}" /><Run Text=" · " /><Run Text="{Binding Name}" /></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static nav:NavigationDestination.DiffViewer}" Content="Diff Viewer 열기" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.BuildRestorePlanCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="선택 항목으로 Restore Plan 만들기" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
