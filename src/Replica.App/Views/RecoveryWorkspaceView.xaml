<UserControl x:Class="Replica.App.Views.RecoveryWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="초기화 후 복구 마법사">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120">
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentStepText}" />
                            <TextBlock Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="14,8" Command="{Binding CancelCommand}" Content="복구 취소" />
                    </Grid>
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,7,7" Padding="8,5" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="7"><TextBlock><Run Text="{Binding Number}" /><Run Text=". " /><Run Text="{Binding Name}" /><Run Text=" · " /><Run FontWeight="SemiBold" Text="{Binding State}" /></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Snapshot 생성 PC" /><TextBlock Margin="0,8,0,0" Text="{Binding SourceComputerText}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" Text="{Binding ScoreText}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock FontWeight="SemiBold" Text="하드웨어 차이" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding HardwareDifferences}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="{Binding Guidance}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Foreground="{DynamicResource WarningBrush}" Text="기존 GPU Driver와 하드웨어 종속 설정은 자동 복원하지 않습니다." TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="드라이브 경로 매핑과 파일 충돌" />
                    <DataGrid Margin="0,10,0,0" MaxHeight="220" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding PathMappings}" AutomationProperties.Name="복구 경로 매핑">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="220" Header="원본 경로" Binding="{Binding SourcePath}" IsReadOnly="True" />
                            <DataGridTextColumn Width="*" Header="새 경로" Binding="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="100" Header="적용 대상" Binding="{Binding Scope}" IsReadOnly="True" />
                            <DataGridTextColumn Width="180" Header="충돌 처리" Binding="{Binding ConflictBehavior}" />
                            <DataGridTextColumn Width="120" Header="예상 용량" Binding="{Binding EstimatedBytes}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding PlanSummary}" />
                    <TextBlock Margin="0,7,0,10" Foreground="{DynamicResource DangerBrush}" Text="복원 계획은 최종 승인 전 실행되지 않으며 Extra 제거·다운그레이드·자동 재부팅을 수행하지 않습니다." TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding AnalyzeCommand}" Content="현재 PC 검사·차이 분석" IsEnabled="{Binding CanAnalyze}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding ApprovePlanCommand}" Content="Restore Plan 최종 승인" IsEnabled="{Binding CanApprovePlan}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding ExecuteCommand}" Content="승인 작업 실행" IsEnabled="{Binding CanExecute}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding RetryFailedCommand}" Content="실패 작업 재시도" IsEnabled="{Binding CanRetry}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding ApproveRestartCommand}" Content="로그인 후 재개 등록" IsEnabled="{Binding CanApproveRestart}" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding ConfirmResumeCommand}" Content="재부팅 후 계속" IsEnabled="{Binding CanConfirmResume}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock FontWeight="SemiBold" Text="실행 결과" /><DataGrid Margin="0,8,0,0" MaxHeight="220" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding ActionResults}"><DataGrid.Columns><DataGridTextColumn Width="*" Header="작업" Binding="{Binding ActionId}" /><DataGridTextColumn Width="110" Header="상태" Binding="{Binding State}" /><DataGridTextColumn Width="*" Header="메시지" Binding="{Binding Message}" /></DataGrid.Columns></DataGrid></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock FontWeight="SemiBold" Text="수동 작업" /><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ManualActions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,7" Text="{Binding Guidance}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="로그인·라이선스·SSH 개인키·유료 플러그인은 Replica가 우회하거나 자동 복원하지 않습니다." TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
