<UserControl x:Class="Replica.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Replica 설정">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900">
            <Border Style="{DynamicResource PageCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Margin="0,8" FontWeight="SemiBold" Text="표시 언어" /><TextBlock Grid.Column="1" Margin="0,8" Text="한국어 (현재 지원 언어)" />
                    <TextBlock Grid.Row="1" Margin="0,8" FontWeight="SemiBold" Text="테마" /><ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" AutomationProperties.Name="밝은 또는 어두운 테마" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                    <TextBlock Grid.Row="2" Margin="0,8" FontWeight="SemiBold" Text="업데이트 채널" /><ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" AutomationProperties.Name="업데이트 채널" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
                </Grid>
            </Border>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="18" FontWeight="SemiBold" Text="기본 Snapshot 폴더" />
                    <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,7" Command="{Binding SelectSnapshotDirectoryCommand}" Content="폴더 선택" /><TextBox AutomationProperties.Name="기본 Snapshot 폴더" IsReadOnly="True" Text="{Binding DefaultSnapshotDirectory}" /></DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Replica는 민감 환경변수 값, 브라우저 로그인 상태, 개인키를 Snapshot에 포함하지 않습니다. 이 안전 정책은 설정으로 끌 수 없습니다." TextWrapping="Wrap" />
            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding StatusText}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,14,0,0"><Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding LoadCommand}" Content="다시 불러오기" /><Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding SaveCommand}" Content="설정 저장 및 적용" /></WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
