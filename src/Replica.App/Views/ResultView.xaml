<UserControl x:Class="Replica.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:Replica.Core.Navigation;assembly=Replica.Core"
             AutomationProperties.Name="복원 결과">
    <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="복원 전 점수" /><TextBlock Margin="0,7,0,0" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="{Binding BeforeScore}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="복원 후 점수" /><TextBlock Margin="0,7,0,0" FontSize="26" Foreground="{DynamicResource AccentBrush}" Text="{Binding AfterScore}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="재부팅" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding RequiresRestart, StringFormat=필요 여부: {0}}" /></StackPanel></Border>
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,6">
                <Border Margin="0,0,10,10" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="성공" /><TextBlock FontSize="24" Foreground="{DynamicResource SuccessBrush}" Text="{Binding SucceededCount}" /></StackPanel></Border>
                <Border Margin="0,0,10,10" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="실패" /><TextBlock FontSize="24" Foreground="{DynamicResource DangerBrush}" Text="{Binding FailedCount}" /></StackPanel></Border>
                <Border Margin="0,0,10,10" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="건너뜀" /><TextBlock FontSize="24" Foreground="{DynamicResource WarningBrush}" Text="{Binding SkippedCount}" /></StackPanel></Border>
                <Border Margin="0,0,0,10" Style="{DynamicResource PageCardStyle}"><StackPanel><TextBlock Text="수동 작업" /><TextBlock FontSize="24" Text="{Binding ManualActionCount}" /></StackPanel></Border>
            </UniformGrid>
            <Border Style="{DynamicResource PageCardStyle}">
                <StackPanel>
                    <TextBlock AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <DataGrid Margin="0,12,0,0" MaxHeight="390" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Items}" AutomationProperties.Name="복원 결과 목록">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Header="작업" Binding="{Binding ActionId}" />
                            <DataGridTextColumn Width="110" Header="상태" Binding="{Binding State}" />
                            <DataGridTextColumn Width="220" Header="결과 이유" Binding="{Binding Reason}" />
                            <DataGridTextColumn Width="*" Header="메시지" Binding="{Binding Message}" />
                            <DataGridTextColumn Width="100" Header="재부팅" Binding="{Binding Restart}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static nav:NavigationDestination.SnapshotHistory}" Content="History·Rollback 열기" />
                        <Button Style="{DynamicResource SecondaryActionButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static nav:NavigationDestination.RestorePlan}" Content="새 Restore Plan 검토" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
